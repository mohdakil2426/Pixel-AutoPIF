{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "catalogUrl", "catalogSha256", "catalogSizeBytes", "catalogSignatureUrl", "generatedAt", "expiresAt", "keyId"],
  "properties": {
    "schemaVersion": {"const": 1},
    "catalogVersion": {"type": "integer", "minimum": 1},
    "catalogUrl": {"type": "string", "format": "uri"},
    "catalogSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalogSizeBytes": {"type": "integer", "minimum": 1, "maximum": 2000000},
    "catalogSignatureUrl": {"type": "string", "format": "uri"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "keyId": {"type": "string", "pattern": "^pixel-autopif-p256-v[0-9]+$"}
  }
}
