{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "maxItems": 64,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["profileId", "model", "manufacturer", "brand", "device", "product", "board", "sourceId"],
    "properties": {
      "profileId": {"type": "string", "pattern": "^pixel_[a-z0-9_]+$"},
      "model": {"type": "string", "pattern": "^Pixel(?: .+)?$"},
      "manufacturer": {"const": "Google"},
      "brand": {"const": "google"},
      "device": {"type": "string", "pattern": "^[a-z0-9_]+$"},
      "product": {"type": "string", "pattern": "^[a-z0-9_]+$"},
      "board": {"type": "string", "pattern": "^[a-z0-9_]+$"},
      "sourceId": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    }
  }
}
